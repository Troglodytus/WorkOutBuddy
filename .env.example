# Strava API app values from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id_here
STRAVA_CLIENT_SECRET=your_client_secret_here

# Database and local data storage
WORKOUTBUDDY_DB=data/workoutbuddy.sqlite

# Web app server
WORKOUTBUDDY_WEB_HOST=0.0.0.0
WORKOUTBUDDY_WEB_PORT=8080

# IMPORTANT: set this to the URL that your browser/iPhone uses to reach the app.
# Local PC example:
# WORKOUTBUDDY_PUBLIC_BASE_URL=http://localhost:8080
# Tailscale MagicDNS example:
# WORKOUTBUDDY_PUBLIC_BASE_URL=http://your-pc.your-tailnet.ts.net:8080
# Cloud/VPS example:
# WORKOUTBUDDY_PUBLIC_BASE_URL=https://workoutbuddy.yourdomain.com
WORKOUTBUDDY_PUBLIC_BASE_URL=http://localhost:8080
